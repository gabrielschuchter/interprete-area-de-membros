# Runtime database URL: Supabase transaction pooler (serverless-safe).
DATABASE_URL="postgresql://postgres.your-project-ref:replace-with-password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Private Supabase Storage for server-side signed asset URLs. Never expose the secret key to the browser.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_STORAGE_BUCKET="learning-assets"
# Realtime uses the Clerk session token; this public key is returned only by the
# Clerk-authenticated configuration endpoint. Supabase Auth cookies/JWT secret are not used.
# SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SUPABASE_SECRET_KEY="sb_secret_..."
# Optional override when the bundled Supabase CA must be replaced.
# DATABASE_CA_CERT_PATH="C:\\path\\to\\prod-ca-2021.crt"

# Clerk authentication
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# Use a matching Clerk Development key pair for localhost.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# Core app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "true" only in a deployment whose writes must be frozen.
APP_WRITE_FREEZE="false"
# Keep new file uploads disabled during the immediate rollback window.
UPLOADS_PAUSED_FOR_ROLLBACK="false"

# Optional protection and observability
ARCJET_KEY=""
# Required by Vercel Cron when scheduled activity deadlines are enabled (32+ characters).
# CRON_SECRET=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
BETTERSTACK_API_KEY=""
BETTERSTACK_URL=""

# Optional analytics integrations; no provider is configured by default.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
