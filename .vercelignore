# Local and generated state should never be uploaded by a CLI deployment.
node_modules
**/node_modules
.next
**/.next
.turbo
**/.turbo
dist
**/dist
coverage
**/coverage
storybook-static
**/storybook-static
packages/database/generated
apps/*/out

# Kiwify migration media and checkpoints are local-only and can be very large.
tmp
**/tmp

# Local recordings migration manifests/checkpoints are operational state,
# not application source. Keep them out of Vercel deployments without deleting them.
/migration-recordings-checkpoint.json
/migration-recordings-delete-dry-run.json
/migration-recordings-manifest.json
/migration-recordings-remux-checkpoint.json
/migration-recordings-remux-delete-dry-run.json
/migration-recordings-remux-manifest.json
/migration-recordings-resume.md
/migration-recordings-source-inventory.json
/scripts/recordings-drive-migration.mjs
/scripts/recordings-drive-remux-migration.mjs
