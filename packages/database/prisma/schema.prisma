// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseExperience {
  ASYNC
  RECORDING_ARCHIVE
}

enum LessonKind {
  TEXT
  VIDEO
  READING
  MIXED
  MATERIAL
}

enum ResourceKind {
  PDF
  ARTICLE
  EXTERNAL_LINK
  FILE
  RECOMMENDED_READING
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum MemberRole {
  MEMBER
  TEACHER
  ADMIN
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ActivitySubmissionStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum ActivityDeliveryKind {
  TEXT
  FILE
  TEXT_AND_FILE
}

enum CommunityVoteKind {
  UP
}

enum CommunityPostKind {
  DISCUSSION
  PUBLICATION
}

enum LibraryItemKind {
  ARTICLE
  PDF
  GUIDE
  LINK
  VIDEO
}

enum MeetingKind {
  INDIVIDUAL
  LESSON
  GROUP
  WORKSHOP
  FEEDBACK
  OTHER
}

enum LessonAssetKind {
  VIDEO
  PDF
  IMAGE
  AUDIO
  FILE
  OTHER
}

enum LessonAssetScope {
  GENERAL
  INDIVIDUAL
}

enum AccessResourceType {
  COURSE
  MODULE
  LESSON
  ASSET
}

enum AccessPermission {
  VIEW
}

enum MigrationEntityType {
  COURSE
  MODULE
  LESSON
  ASSET
  STUDENT
}

enum MigrationStatus {
  DISCOVERED
  IMPORTED
  AMBIGUOUS
  FAILED
}

enum MigrationStudentMatchStatus {
  UNMATCHED
  EXACT
  AMBIGUOUS
}

enum ImportedRecordingGroupAssignmentAction {
  ASSIGNED
  REASSIGNED
  REVOKED
}

enum CollectionItemType {
  LESSON
  RECORDING
  LIBRARY_ITEM
}

enum HomeBlockType {
  NEXT_MEETING
  PREPARATION
  CONTINUE_WATCHING
  PENDING_ACTIVITY
  FEEDBACK
  ASYNC_LEARNING
  COMMUNITY
  COLLECTION
}

model Member {
  id                                  String                             @id
  displayName                         String?
  email                               String?
  avatarUrl                           String?
  role                                MemberRole                         @default(MEMBER)
  onboardingStatus                    OnboardingStatus                   @default(NOT_STARTED)
  onboardingStep                      Int                                @default(0)
  onboardingVersion                   Int                                @default(1)
  onboardingStartedAt                 DateTime?
  onboardingCompletedAt               DateTime?
  createdAt                           DateTime                           @default(now())
  updatedAt                           DateTime                           @updatedAt
  profile                             Profile?
  ownedAssets                         LessonAsset[]                      @relation("OwnedLessonAssets")
  accessGrants                        AccessGrant[]
  migrationStudents                   MigrationStudent[]                 @relation("MigrationStudentMember")
  notifications                       Notification[]                     @relation("NotificationRecipient")
  notificationsAsActor                Notification[]                     @relation("NotificationActor")
  mentionsSent                        Mention[]                          @relation("MentionActor")
  mentionsReceived                    Mention[]                          @relation("MentionTarget")
  notificationPreference              NotificationPreference?
  topicFollows                        TopicFollow[]
  mutationRateLimits                  MutationRateLimit[]
  activityAssignments                 ActivityAssignment[]
  activitySubmissions                 ActivitySubmission[]
  libraryBookmarks                    LibraryBookmark[]
  meetingParticipations               MeetingParticipant[]
  playbackProgress                    PlaybackProgress[]
  importedRecordingGroups             ImportedRecordingGroup[]           @relation("ImportedRecordingGroupMember")
  recordingGroupAssignmentsAsMember   ImportedRecordingGroupAssignment[] @relation("ImportedRecordingGroupMemberTarget")
  recordingGroupAssignmentsAsPrevious ImportedRecordingGroupAssignment[] @relation("ImportedRecordingGroupPreviousMember")
  recordingGroupAssignmentsBy         ImportedRecordingGroupAssignment[] @relation("ImportedRecordingGroupChangedBy")
  recordingGroupAssignmentsAsAssigner ImportedRecordingGroup[]           @relation("ImportedRecordingGroupAssignedBy")
  productSettingsUpdated              ProductSetting[]                   @relation("ProductSettingUpdatedBy")
  homeBlocksCreated                   HomeBlockConfiguration[]           @relation("HomeBlockCreatedBy")
  homeBlocksUpdated                   HomeBlockConfiguration[]           @relation("HomeBlockUpdatedBy")
  contentCollectionsCreated           ContentCollection[]                @relation("ContentCollectionCreatedBy")
  contentCollectionsUpdated           ContentCollection[]                @relation("ContentCollectionUpdatedBy")

  @@index([role])
}

model Profile {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  username    String   @unique
  displayName String?
  avatarUrl   String?
  headline    String?
  bio         String?  @db.Text
  occupation  String?
  institution String?
  city        String?
  state       String?
  country     String?
  website     String?
  instagram   String?
  linkedin    String?
  interests   String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  member      Member   @relation(fields: [clerkUserId], references: [id], onDelete: Cascade)

  @@index([displayName])
}

model LearningPath {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?       @db.Text
  coverUrl    String?
  status      ContentStatus @default(DRAFT)
  position    Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  courses     Course[]

  @@index([status, position])
}

model Course {
  id              String           @id @default(cuid())
  title           String
  subtitle        String?          @db.Text
  slug            String           @unique
  description     String?          @db.Text
  coverUrl        String?
  format          String?
  category        String?
  level           String?
  durationMinutes Int?
  tags            String[]         @default([])
  experience      CourseExperience @default(ASYNC)
  teacherId       String?
  status          ContentStatus    @default(DRAFT)
  position        Int              @default(0)
  publishedAt     DateTime?
  createdBy       String?
  updatedBy       String?
  learningPathId  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  learningPath    LearningPath?    @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  modules         Module[]
  enrollments     Enrollment[]
  activities      Activity[]
  meetings        Meeting[]

  @@unique([learningPathId, position])
  @@index([status, position])
  @@index([learningPathId, status, position])
}

model Module {
  id                      String                   @id @default(cuid())
  title                   String
  slug                    String
  description             String?                  @db.Text
  objectives              String[]                 @default([])
  position                Int                      @default(0)
  status                  ContentStatus            @default(DRAFT)
  courseId                String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  course                  Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons                 Lesson[]
  importedRecordingGroups ImportedRecordingGroup[]

  @@unique([courseId, slug])
  @@unique([courseId, position])
  @@index([status, courseId, position])
}

model Lesson {
  id                 String                  @id @default(cuid())
  title              String
  slug               String
  description        String?                 @db.Text
  objectives         String[]                @default([])
  content            Json
  kind               LessonKind              @default(TEXT)
  status             ContentStatus           @default(DRAFT)
  position           Int                     @default(0)
  publishedAt        DateTime?
  createdBy          String?
  updatedBy          String?
  moduleId           String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  module             Module                  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources          LessonResource[]
  libraryItems       LibraryItem[]
  assets             LessonAsset[]
  progress           LessonProgress[]
  activities         Activity[]
  importedRecordings ImportedRecording[]
  collectionItems    ContentCollectionItem[]

  @@unique([moduleId, slug])
  @@unique([moduleId, position])
  @@index([status, moduleId, position])
}

model LessonResource {
  id        String       @id @default(cuid())
  title     String
  kind      ResourceKind
  url       String       @db.Text
  position  Int          @default(0)
  lessonId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  lesson    Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
}

model LessonAsset {
  id                String                  @id @default(cuid())
  title             String
  kind              LessonAssetKind
  scope             LessonAssetScope        @default(GENERAL)
  storagePath       String?                 @db.Text
  externalUrl       String?                 @db.Text
  mimeType          String?
  sizeBytes         BigInt?
  durationSeconds   Int?
  checksum          String?
  sourcePlatform    String?
  sourceId          String?
  originalTitle     String?
  position          Int                     @default(0)
  ownerMemberId     String?
  lessonId          String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  lesson            Lesson                  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  ownerMember       Member?                 @relation("OwnedLessonAssets", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  importedRecording ImportedRecording?
  playbackProgress  PlaybackProgress[]
  collectionItems   ContentCollectionItem[]

  @@unique([lessonId, position])
  @@unique([sourcePlatform, sourceId])
  @@index([lessonId, kind, position])
  @@index([ownerMemberId, scope])
}

model Enrollment {
  id          String           @id @default(cuid())
  memberId    String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([memberId, courseId])
  @@index([courseId])
  @@index([memberId, status])
}

model AccessGrant {
  id             String             @id @default(cuid())
  memberId       String
  resourceType   AccessResourceType
  resourceId     String
  permission     AccessPermission   @default(VIEW)
  sourcePlatform String?
  sourceId       String?
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  member         Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, resourceType, resourceId])
  @@index([resourceType, resourceId])
  @@index([memberId, expiresAt])
}

model MigrationRecord {
  id             String              @id @default(cuid())
  sourcePlatform String
  entityType     MigrationEntityType
  sourceId       String
  targetId       String?
  status         MigrationStatus     @default(DISCOVERED)
  checksum       String?
  metadata       Json?
  lastError      String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([sourcePlatform, entityType, sourceId])
  @@index([status, sourcePlatform])
  @@index([targetId])
}

model MigrationStudent {
  id                      String                      @id @default(cuid())
  sourcePlatform          String
  sourceId                String
  displayName             String
  email                   String?
  memberId                String?
  matchStatus             MigrationStudentMatchStatus @default(UNMATCHED)
  notes                   String?                     @db.Text
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  member                  Member?                     @relation("MigrationStudentMember", fields: [memberId], references: [id], onDelete: SetNull)
  importedRecordingGroups ImportedRecordingGroup[]

  @@unique([sourcePlatform, sourceId])
  @@index([email])
  @@index([memberId])
  @@index([matchStatus])
}

model ImportedRecordingGroup {
  id                 String                             @id @default(cuid())
  sourcePlatform     String
  sourceId           String
  legacyStudentName  String
  legacyStudentId    String?
  legacyModuleId     String                             @unique
  memberId           String?
  assignedAt         DateTime?
  assignedByMemberId String?
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt
  legacyStudent      MigrationStudent?                  @relation(fields: [legacyStudentId], references: [id], onDelete: SetNull)
  legacyModule       Module                             @relation(fields: [legacyModuleId], references: [id], onDelete: Restrict)
  member             Member?                            @relation("ImportedRecordingGroupMember", fields: [memberId], references: [id], onDelete: SetNull)
  assignedByMember   Member?                            @relation("ImportedRecordingGroupAssignedBy", fields: [assignedByMemberId], references: [id], onDelete: SetNull)
  recordings         ImportedRecording[]
  assignments        ImportedRecordingGroupAssignment[]

  @@unique([sourcePlatform, sourceId])
  @@index([memberId, updatedAt])
  @@index([legacyStudentId])
}

model ImportedRecording {
  id              String                  @id @default(cuid())
  groupId         String
  assetId         String                  @unique
  legacyLessonId  String
  meetingId       String?
  sourcePlatform  String
  sourceId        String
  originalTitle   String?
  meetingDate     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  group           ImportedRecordingGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  asset           LessonAsset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  legacyLesson    Lesson                  @relation(fields: [legacyLessonId], references: [id], onDelete: Restrict)
  meeting         Meeting?                @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  collectionItems ContentCollectionItem[]

  @@unique([sourcePlatform, sourceId])
  @@index([groupId, meetingDate])
  @@index([meetingId, meetingDate])
  @@index([legacyLessonId])
}

model ImportedRecordingGroupAssignment {
  id                String                                 @id @default(cuid())
  groupId           String
  previousMemberId  String?
  memberId          String?
  changedByMemberId String
  action            ImportedRecordingGroupAssignmentAction
  note              String?                                @db.Text
  createdAt         DateTime                               @default(now())
  group             ImportedRecordingGroup                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  previousMember    Member?                                @relation("ImportedRecordingGroupPreviousMember", fields: [previousMemberId], references: [id], onDelete: SetNull)
  member            Member?                                @relation("ImportedRecordingGroupMemberTarget", fields: [memberId], references: [id], onDelete: SetNull)
  changedBy         Member                                 @relation("ImportedRecordingGroupChangedBy", fields: [changedByMemberId], references: [id], onDelete: Restrict)

  @@index([groupId, createdAt])
  @@index([memberId, createdAt])
}

model PlaybackProgress {
  id                  String      @id @default(cuid())
  memberId            String
  assetId             String
  positionSeconds     Int         @default(0)
  durationSeconds     Int?
  lastViewedAt        DateTime    @default(now())
  completedPlaybackAt DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  member              Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  asset               LessonAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([memberId, assetId])
  @@index([memberId, lastViewedAt])
  @@index([assetId, lastViewedAt])
}

model LessonProgress {
  id          String         @id @default(cuid())
  memberId    String
  lessonId    String
  status      ProgressStatus @default(IN_PROGRESS)
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([memberId, lessonId])
  @@index([lessonId])
  @@index([memberId, status])
}

model Activity {
  id                   String               @id @default(cuid())
  idempotencyKey       String?
  title                String
  slug                 String               @unique
  prompt               String               @db.Text
  instructions         String?              @db.Text
  deliveryKind         ActivityDeliveryKind @default(TEXT)
  status               ContentStatus        @default(DRAFT)
  position             Int                  @default(0)
  dueAt                DateTime?
  courseId             String?
  lessonId             String?
  relatedLibraryItemId String?
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  course               Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson               Lesson?              @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  submissions          ActivitySubmission[]
  assignments          ActivityAssignment[]
  meetings             Meeting[]            @relation("MeetingActivity")
  relatedLibraryItem   LibraryItem?         @relation("ActivityLibraryItem", fields: [relatedLibraryItemId], references: [id], onDelete: SetNull)

  @@unique([createdBy, idempotencyKey])
  @@index([status, position])
  @@index([courseId, status, position])
  @@index([lessonId, status])
  @@index([relatedLibraryItemId])
}

model ActivitySubmission {
  id                  String                   @id @default(cuid())
  activityId          String
  memberId            String
  content             String                   @db.Text
  status              ActivitySubmissionStatus @default(DRAFT)
  attachmentPath      String?                  @db.Text
  attachmentName      String?
  attachmentMimeType  String?
  attachmentSizeBytes BigInt?
  submittedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  activity            Activity                 @relation(fields: [activityId], references: [id], onDelete: Cascade)
  member              Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  feedback            Feedback?

  @@unique([activityId, memberId])
  @@index([memberId, status, updatedAt])
  @@index([activityId, status])
}

model ActivityAssignment {
  id         String    @id @default(cuid())
  activityId String
  memberId   String
  dueAt      DateTime?
  assignedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  activity   Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([activityId, memberId])
  @@index([memberId, dueAt])
  @@index([activityId, dueAt])
}

model Feedback {
  id           String             @id @default(cuid())
  submissionId String             @unique
  teacherId    String
  content      String             @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  submission   ActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Notification {
  id               String    @id @default(cuid())
  memberId         String
  actorId          String?
  type             String
  entityType       String?
  entityId         String?
  parentEntityType String?
  parentEntityId   String?
  metadata         Json?
  groupKey         String?
  dedupeKey        String?   @unique
  priority         Int       @default(0)
  title            String
  body             String?   @db.Text
  href             String?   @db.Text
  seenAt           DateTime?
  readAt           DateTime?
  createdAt        DateTime  @default(now())
  member           Member    @relation("NotificationRecipient", fields: [memberId], references: [id], onDelete: Cascade)
  actor            Member?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([memberId, readAt, createdAt])
  @@index([memberId, seenAt, createdAt])
  @@index([memberId, type, createdAt])
  @@index([groupKey, createdAt])
}

model Mention {
  id              String   @id @default(cuid())
  actorId         String
  mentionedUserId String
  entityType      String
  entityId        String
  createdAt       DateTime @default(now())
  actor           Member   @relation("MentionActor", fields: [actorId], references: [id], onDelete: Cascade)
  mentionedUser   Member   @relation("MentionTarget", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([actorId, mentionedUserId, entityType, entityId])
  @@index([mentionedUserId, createdAt])
  @@index([entityType, entityId])
}

model NotificationPreference {
  id                    String   @id @default(cuid())
  memberId              String   @unique
  mentions              Boolean  @default(true)
  commentReplies        Boolean  @default(true)
  topicComments         Boolean  @default(true)
  followedTopicActivity Boolean  @default(true)
  lessonAvailable       Boolean  @default(true)
  moduleAvailable       Boolean  @default(true)
  activityAssigned      Boolean  @default(true)
  feedbackReceived      Boolean  @default(true)
  activityDeadline      Boolean  @default(true)
  announcements         Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  member                Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model TopicFollow {
  id        String        @id @default(cuid())
  userId    String
  topicId   String
  createdAt DateTime      @default(now())
  mutedAt   DateTime?
  user      Member        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     CommunityPost @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([topicId, mutedAt, createdAt])
  @@index([userId, mutedAt, createdAt])
}

model CommunitySpace {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  description    String?         @db.Text
  icon           String?
  commentsClosed Boolean         @default(false)
  status         ContentStatus   @default(DRAFT)
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  posts          CommunityPost[]

  @@index([status, position])
}

model CommunityPost {
  id             String              @id @default(cuid())
  spaceId        String?
  authorId       String
  idempotencyKey String?
  kind           CommunityPostKind   @default(DISCUSSION)
  title          String
  subtitle       String?             @db.Text
  slug           String?             @unique
  content        String              @db.Text
  excerpt        String?             @db.Text
  contentJson    Json?
  tags           String[]            @default([])
  coverUrl       String?
  status         ContentStatus       @default(PUBLISHED)
  isPinned       Boolean             @default(false)
  isFeatured     Boolean             @default(false)
  featuredAt     DateTime?
  publishedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  space          CommunitySpace?     @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  comments       CommunityComment[]
  votes          PostVote[]
  bookmarks      CommunityBookmark[]
  followers      TopicFollow[]

  @@unique([authorId, idempotencyKey])
  @@index([spaceId, status, createdAt])
  @@index([kind, status, createdAt])
  @@index([status, publishedAt, createdAt])
  @@index([authorId, createdAt])
  @@index([isPinned, status, createdAt])
}

model CommunityBookmark {
  id        String        @id @default(cuid())
  postId    String
  memberId  String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, memberId])
  @@index([memberId, createdAt])
}

model CommunityComment {
  id             String             @id @default(cuid())
  postId         String
  authorId       String
  idempotencyKey String?
  parentId       String?
  content        String             @db.Text
  contentJson    Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  post           CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent         CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies        CommunityComment[] @relation("CommentReplies")
  votes          CommentVote[]

  @@unique([authorId, idempotencyKey])
  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@index([authorId, createdAt])
}

model PostVote {
  id        String            @id @default(cuid())
  postId    String
  memberId  String
  kind      CommunityVoteKind @default(UP)
  createdAt DateTime          @default(now())
  post      CommunityPost     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, memberId])
  @@index([memberId, createdAt])
}

model CommentVote {
  id        String            @id @default(cuid())
  commentId String
  memberId  String
  kind      CommunityVoteKind @default(UP)
  createdAt DateTime          @default(now())
  comment   CommunityComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, memberId])
  @@index([memberId, createdAt])
}

model MutationRateLimit {
  id          String   @id @default(cuid())
  memberId    String
  action      String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, action, windowStart])
  @@index([memberId, action, updatedAt])
  @@index([windowStart])
}

model Meeting {
  id                   String               @id @default(cuid())
  idempotencyKey       String?
  title                String
  description          String?              @db.Text
  startsAt             DateTime
  endsAt               DateTime?
  timezone             String               @default("America/Sao_Paulo")
  joinUrl              String               @db.Text
  recordingUrl         String?              @db.Text
  status               ContentStatus        @default(DRAFT)
  teacherId            String?
  courseId             String?
  position             Int                  @default(0)
  kind                 MeetingKind          @default(OTHER)
  recurrenceRule       String?
  demoKey              String?              @unique
  relatedActivityId    String?
  relatedLibraryItemId String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  course               Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  relatedActivity      Activity?            @relation("MeetingActivity", fields: [relatedActivityId], references: [id], onDelete: SetNull)
  relatedLibraryItem   LibraryItem?         @relation("MeetingLibraryItem", fields: [relatedLibraryItemId], references: [id], onDelete: SetNull)
  participants         MeetingParticipant[]
  recordings           ImportedRecording[]

  @@unique([teacherId, idempotencyKey])
  @@index([status, startsAt])
  @@index([teacherId, startsAt])
  @@index([courseId, startsAt])
  @@index([relatedActivityId])
  @@index([relatedLibraryItemId])
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meetingId String
  memberId  String
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([meetingId, memberId])
  @@index([memberId, meetingId])
}

model LibraryItem {
  id              String                  @id @default(cuid())
  idempotencyKey  String?
  title           String
  description     String?                 @db.Text
  kind            LibraryItemKind
  category        String?
  tags            String[]
  url             String                  @db.Text
  authors         String?                 @db.Text
  year            Int?
  doi             String?
  pmid            String?
  storagePath     String?                 @db.Text
  mimeType        String?
  sizeBytes       BigInt?
  status          ContentStatus           @default(DRAFT)
  position        Int                     @default(0)
  createdBy       String?
  updatedBy       String?
  lessonId        String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  bookmarks       LibraryBookmark[]
  meetings        Meeting[]               @relation("MeetingLibraryItem")
  lesson          Lesson?                 @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  activities      Activity[]              @relation("ActivityLibraryItem")
  collectionItems ContentCollectionItem[]

  @@unique([createdBy, idempotencyKey])
  @@index([status, category, position])
  @@index([status, createdAt])
  @@index([lessonId])
}

model LibraryBookmark {
  id        String      @id @default(cuid())
  itemId    String
  memberId  String
  createdAt DateTime    @default(now())
  item      LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  member    Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([itemId, memberId])
  @@index([memberId, createdAt])
}

model ProductSetting {
  id                String   @id @default(cuid())
  key               String   @unique
  value             Json
  updatedByMemberId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  updatedBy         Member?  @relation("ProductSettingUpdatedBy", fields: [updatedByMemberId], references: [id], onDelete: SetNull)

  @@index([updatedByMemberId])
}

model ContentCollection {
  id                String                   @id @default(cuid())
  title             String
  slug              String                   @unique
  description       String?                  @db.Text
  status            ContentStatus            @default(DRAFT)
  position          Int                      @default(0)
  createdByMemberId String?
  updatedByMemberId String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  items             ContentCollectionItem[]
  createdBy         Member?                  @relation("ContentCollectionCreatedBy", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  updatedBy         Member?                  @relation("ContentCollectionUpdatedBy", fields: [updatedByMemberId], references: [id], onDelete: SetNull)
  homeBlocks        HomeBlockConfiguration[]

  @@index([status, position])
}

model ContentCollectionItem {
  id            String             @id @default(cuid())
  collectionId  String
  itemType      CollectionItemType
  lessonId      String?
  assetId       String?
  recordingId   String?
  libraryItemId String?
  position      Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  collection    ContentCollection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  lesson        Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  asset         LessonAsset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  recording     ImportedRecording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  libraryItem   LibraryItem?       @relation(fields: [libraryItemId], references: [id], onDelete: SetNull)

  @@unique([collectionId, position])
  @@unique([collectionId, itemType, lessonId])
  @@unique([collectionId, itemType, assetId])
  @@unique([collectionId, itemType, recordingId])
  @@unique([collectionId, itemType, libraryItemId])
  @@index([itemType, lessonId])
  @@index([itemType, assetId])
  @@index([itemType, recordingId])
  @@index([recordingId])
  @@index([itemType, libraryItemId])
}

model HomeBlockConfiguration {
  id                String             @id @default(cuid())
  type              HomeBlockType
  title             String?
  subtitle          String?            @db.Text
  enabled           Boolean            @default(true)
  position          Int                @default(0)
  itemCount         Int                @default(4)
  collectionId      String?
  createdByMemberId String?
  updatedByMemberId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  collection        ContentCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdBy         Member?            @relation("HomeBlockCreatedBy", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  updatedBy         Member?            @relation("HomeBlockUpdatedBy", fields: [updatedByMemberId], references: [id], onDelete: SetNull)

  @@unique([type])
  @@index([enabled, position])
  @@index([collectionId])
}
