  startedAt       DateTime                @default(now())
  endedAt         DateTime?
  member          Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  intervals       StudyActivityInterval[]

  @@unique([memberId, clientSessionId])
  @@index([memberId, lastHeartbeatAt])
  @@index([activityKind, resourceId, startedAt])
}

model StudyActivityInterval {
  id         String               @id @default(cuid())
  memberId   String
  sessionId  String
  sequence   Int
  startedAt  DateTime
  endedAt    DateTime
  seconds    Int
  isPlayback Boolean              @default(false)
  createdAt  DateTime             @default(now())
  member     Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session    StudyTrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([memberId, startedAt])
  @@index([memberId, isPlayback, startedAt])
}

model StudyGoal {
  id            String                 @id @default(cuid())
  memberId      String
  period        StudyGoalPeriod
  targetMinutes Int
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  member        Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  revisions     StudyGoalRevision[]
  achievements  StudyGoalAchievement[]

  @@unique([memberId, period])
  @@index([memberId, updatedAt])
}

model StudyGoalRevision {
  id            String    @id @default(cuid())
  studyGoalId   String
  targetMinutes Int
  changedAt     DateTime  @default(now())
  studyGoal     StudyGoal @relation(fields: [studyGoalId], references: [id], onDelete: Cascade)

  @@index([studyGoalId, changedAt])
}

model StudyGoalAchievement {
  id         String    @id @default(cuid())
  goalId     String
  memberId   String
  periodKey  String
  achievedAt DateTime  @default(now())
  goal       StudyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([goalId, periodKey])
  @@index([memberId, achievedAt])
}

model LearningTask {
  id                String                   @id @default(cuid())
  createdByMemberId String?
  title             String
  description       String?                  @db.Text
  recurrence        LearningTaskRecurrence   @default(ONCE)
  startsAt          DateTime                 @default(now())
  dueAt             DateTime?
  archivedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  createdBy         Member?                  @relation("LearningTaskCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  recipients        LearningTaskRecipient[]
  completions       LearningTaskCompletion[]

  @@index([createdByMemberId, archivedAt, dueAt])
  @@index([recurrence, startsAt, dueAt])
}

model LearningTaskRecipient {
  id         String       @id @default(cuid())
  taskId     String
  memberId   String
  assignedAt DateTime     @default(now())
  task       LearningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member     Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([taskId, memberId])
  @@index([memberId, assignedAt])
}

model LearningTaskCompletion {
  id          String       @id @default(cuid())
  taskId      String
  memberId    String
  periodKey   String
  completedAt DateTime     @default(now())
  task        LearningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([taskId, memberId, periodKey])
  @@index([memberId, completedAt])
  @@index([taskId, periodKey])
}

model StudyCampaign {
  id                String    @id @default(cuid())
  createdByMemberId String?
  title             String
  description       String?   @db.Text
  targetMinutes     Int
  startsAt          DateTime
  endsAt            DateTime
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         Member?   @relation("StudyCampaignCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)

  @@index([publishedAt, archivedAt, startsAt, endsAt])
}

model BadgeDefinition {
  id                String                    @id @default(cuid())
  slug              String                    @unique
  title             String
  description       String                    @db.Text
  criterion         BadgeCriterion
  threshold         Int
  imageUrl          String?
  status            ContentStatus             @default(DRAFT)
  version           Int                       @default(1)
  createdByMemberId String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  createdBy         Member?                   @relation("BadgeDefinitionCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  awards            BadgeAward[]
  revisions         BadgeDefinitionRevision[]

  @@unique([criterion, threshold, slug])
  @@index([status, criterion, threshold])
  @@index([createdByMemberId, createdAt])
}

model BadgeDefinitionRevision {
  id                String          @id @default(cuid())
  badgeId           String
  version           Int
  title             String
  description       String          @db.Text
  criterion         BadgeCriterion
  threshold         Int
  imageUrl          String?
  createdByMemberId String?
  createdAt         DateTime        @default(now())
  badge             BadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Restrict)
  createdBy         Member?         @relation("BadgeRevisionCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  awards            BadgeAward[]

  @@unique([badgeId, version])
  @@index([createdByMemberId, createdAt])
}

model BadgeAward {
  id                   String                  @id @default(cuid())
  memberId             String
  badgeId              String
  definitionRevisionId String
  awardedAt            DateTime                @default(now())
  member               Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  badge                BadgeDefinition         @relation(fields: [badgeId], references: [id], onDelete: Restrict)
  definitionRevision   BadgeDefinitionRevision @relation(fields: [definitionRevisionId], references: [id], onDelete: Restrict)

  @@unique([memberId, badgeId])
  @@index([memberId, awardedAt])
  @@index([badgeId, awardedAt])
}

model BadgeEvaluationState {
  id              String    @id @default(cuid())
  memberId        String    @unique
  lastEvaluatedAt DateTime?
  updatedAt       DateTime  @updatedAt
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
}
