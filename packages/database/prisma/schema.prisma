}

model PlannerBoardColumn {
  id        String            @id @default(cuid())
  memberId  String
  status    PlannerTaskStatus
  label     String
  color     String
  position  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, status])
  @@index([memberId, position])
}

model PlannerTask {
  id              String                  @id @default(cuid())
  memberId        String
  title           String
  description     String?                 @db.Text
  status          PlannerTaskStatus       @default(TODO)
  priority        PlannerPriority         @default(MEDIUM)
  category        String?
  dueAt           DateTime?
  recurrence      PlannerRecurrence       @default(NONE)
  recurrenceUntil DateTime?
  reminderMinutes Int?
  sortOrder       Int                     @default(0)
  parentTaskId    String?
  deletedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  member          Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  parent          PlannerTask?            @relation("PlannerTaskSubtasks", fields: [parentTaskId, memberId], references: [id, memberId], onDelete: Cascade)
  subtasks        PlannerTask[]           @relation("PlannerTaskSubtasks")
  occurrences     PlannerTaskOccurrence[]

  @@unique([id, memberId])
  @@index([memberId, deletedAt, dueAt, status])
  @@index([memberId, status, sortOrder])
  @@index([parentTaskId, deletedAt, sortOrder])
}

model PlannerTaskOccurrence {
  id                  String             @id @default(cuid())
  taskId              String
  memberId            String
  occurrenceAt        DateTime
  dueAtOverride       DateTime?
  titleOverride       String?
  descriptionOverride String?            @db.Text
  status              PlannerTaskStatus?
  priority            PlannerPriority?
  deletedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  task                PlannerTask        @relation(fields: [taskId, memberId], references: [id, memberId], onDelete: Cascade)

  @@unique([taskId, occurrenceAt])
  @@index([memberId, occurrenceAt, deletedAt])
}

model PlannerEvent {
  id              String                   @id @default(cuid())
  memberId        String
  title           String
  description     String?                  @db.Text
  kind            PlannerEventKind         @default(PERSONAL)
  startsAt        DateTime
  endsAt          DateTime
  timezone        String                   @default("America/Sao_Paulo")
  allDay          Boolean                  @default(false)
  color           String                   @default("#7A5A69")
  location        String?
  recurrence      PlannerRecurrence        @default(NONE)
  recurrenceUntil DateTime?
  reminderMinutes Int?
  deletedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  member          Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  occurrences     PlannerEventOccurrence[]

  @@unique([id, memberId])
  @@index([memberId, deletedAt, startsAt, endsAt])
}

model PlannerEventOccurrence {
  id                  String       @id @default(cuid())
  eventId             String
  memberId            String
  occurrenceStartsAt  DateTime
  startsAtOverride    DateTime?
  endsAtOverride      DateTime?
  titleOverride       String?
  descriptionOverride String?      @db.Text
  colorOverride       String?
  deletedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  event               PlannerEvent @relation(fields: [eventId, memberId], references: [id, memberId], onDelete: Cascade)

  @@unique([eventId, occurrenceStartsAt])
  @@index([memberId, occurrenceStartsAt, deletedAt])
}

model PlannerReminder {
  id            String      @id @default(cuid())
  memberId      String
  entityType    String
  entityId      String
  occurrenceAt  DateTime?
  remindAt      DateTime
  domainEventId String      @unique
  cancelledAt   DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime    @default(now())
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  domainEvent   DomainEvent @relation(fields: [domainEventId], references: [id], onDelete: Restrict)

  @@index([memberId, remindAt, cancelledAt, deliveredAt])
  @@index([entityType, entityId, occurrenceAt])
}

model FocusTimerSession {
  id                 String                     @id @default(cuid())
  memberId           String
  clientId           String?
  mode               FocusTimerMode
  title              String?
  durationSeconds    Int?
  startedAt          DateTime                   @default(now())
  runStartedAt       DateTime?
  pausedAt           DateTime?
  elapsedBeforePause Int                        @default(0)
  endedAt            DateTime?
  completedAt        DateTime?
  linkedResourceType String?
  linkedResourceId   String?
  sessionNote        String?                    @db.Text
  needsReview        Boolean                    @default(false)
  manuallyEntered    Boolean                    @default(false)
  studyLoggedAt      DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  member             Member                     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  segments           FocusTimerSessionSegment[]

  @@unique([id, memberId])
  @@index([memberId, startedAt])
  @@index([memberId, endedAt, startedAt])
}

model FocusTimerSessionSegment {
  id        String            @id @default(cuid())
  sessionId String
  memberId  String
  startedAt DateTime
  endedAt   DateTime?
  session   FocusTimerSession @relation(fields: [sessionId, memberId], references: [id, memberId], onDelete: Cascade)

  @@index([memberId, startedAt, endedAt])
}

model PlannerNoteFolder {
  id        String              @id @default(cuid())
  memberId  String
  parentId  String?
  name      String
  icon      String              @default("folder")
  position  Int                 @default(0)
  deletedAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  member    Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  parent    PlannerNoteFolder?  @relation("PlannerNoteFolderTree", fields: [parentId, memberId], references: [id, memberId], onDelete: Cascade)
  children  PlannerNoteFolder[] @relation("PlannerNoteFolderTree")
  notes     PlannerNote[]

  @@unique([memberId, name])
  @@unique([id, memberId])
  @@index([memberId, parentId, deletedAt, position])
}

model PlannerNote {
  id                 String                     @id @default(cuid())
  memberId           String
  folderId           String?
  title              String                     @default("Sem título")
  contentJson        Json
  contentText        String                     @default("") @db.Text
  linkedResourceType String?
  linkedResourceId   String?
  videoTimeSeconds   Int?
  pinnedAt           DateTime?
  deletedAt          DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  member             Member                     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  folder             PlannerNoteFolder?         @relation(fields: [folderId, memberId], references: [id, memberId], onDelete: Restrict)
  tags               PlannerNoteTagAssignment[]

  @@unique([id, memberId])
  @@index([memberId, deletedAt, pinnedAt, updatedAt])
  @@index([folderId, deletedAt, updatedAt])
}

model PlannerNoteTag {
  id        String                     @id @default(cuid())
  memberId  String
  name      String
  createdAt DateTime                   @default(now())
  member    Member                     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  notes     PlannerNoteTagAssignment[]

  @@unique([memberId, name])
  @@unique([id, memberId])
  @@index([memberId, name])
}

model PlannerNoteTagAssignment {
  noteId   String
  tagId    String
  memberId String
  note     PlannerNote    @relation(fields: [noteId, memberId], references: [id, memberId], onDelete: Cascade)
  tag      PlannerNoteTag @relation(fields: [tagId, memberId], references: [id, memberId], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([memberId, noteId])
  @@index([tagId, noteId])
}

model GlobalSearchHistory {
  id              String   @id @default(cuid())
  memberId        String
  query           String
  normalizedQuery String
  createdAt       DateTime @default(now())
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, normalizedQuery])
  @@index([memberId, createdAt])
}

model StudyCampaign {
  id                String                   @id @default(cuid())
  createdByMemberId String?
  title             String
  description       String?                  @db.Text
  targetMinutes     Int
  startsAt          DateTime
  endsAt            DateTime
  renewalMode       StudyCampaignRenewalMode @default(MANUAL)
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  createdBy         Member?                  @relation("StudyCampaignCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  snapshots         StudyCampaignSnapshot[]

  @@index([publishedAt, archivedAt, startsAt, endsAt])
}

model StudyCampaignSnapshot {
  id             String              @id @default(cuid())
  campaignId     String
  periodStartsAt DateTime
  periodEndsAt   DateTime
  targetMinutes  Int
  totalSeconds   BigInt
  sourceKinds    StudyActivityKind[] @default([])
  snapshottedAt  DateTime            @default(now())
  campaign       StudyCampaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@unique([campaignId, periodStartsAt, periodEndsAt])
  @@index([campaignId, snapshottedAt])
}

model BadgeDefinition {
  id                String                    @id @default(cuid())
  slug              String                    @unique
  title             String
  description       String                    @db.Text
  criterion         BadgeCriterion
  threshold         Int
  imageUrl          String?
  status            ContentStatus             @default(DRAFT)
  version           Int                       @default(1)
  createdByMemberId String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  createdBy         Member?                   @relation("BadgeDefinitionCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  awards            BadgeAward[]
  revisions         BadgeDefinitionRevision[]

  @@unique([criterion, threshold, slug])
  @@index([status, criterion, threshold])
  @@index([createdByMemberId, createdAt])
}

model BadgeDefinitionRevision {
  id                String          @id @default(cuid())
  badgeId           String
  version           Int
  title             String
  description       String          @db.Text
  criterion         BadgeCriterion
  threshold         Int
  imageUrl          String?
  createdByMemberId String?
  createdAt         DateTime        @default(now())
  badge             BadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Restrict)
  createdBy         Member?         @relation("BadgeRevisionCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  awards            BadgeAward[]

  @@unique([badgeId, version])
  @@index([createdByMemberId, createdAt])
}

model BadgeAward {
  id                   String                  @id @default(cuid())
  memberId             String
  badgeId              String
  definitionRevisionId String
  awardedAt            DateTime                @default(now())
  member               Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  badge                BadgeDefinition         @relation(fields: [badgeId], references: [id], onDelete: Restrict)
  definitionRevision   BadgeDefinitionRevision @relation(fields: [definitionRevisionId], references: [id], onDelete: Restrict)

  @@unique([memberId, badgeId])
  @@index([memberId, awardedAt])
  @@index([badgeId, awardedAt])
}

model BadgeEvaluationState {
  id              String    @id @default(cuid())
  memberId        String    @unique
  lastEvaluatedAt DateTime?
  updatedAt       DateTime  @updatedAt
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
}
