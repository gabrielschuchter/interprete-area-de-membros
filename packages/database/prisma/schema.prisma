// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonKind {
  TEXT
  VIDEO
  READING
  MIXED
  MATERIAL
}

enum ResourceKind {
  PDF
  ARTICLE
  EXTERNAL_LINK
  FILE
  RECOMMENDED_READING
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum MemberRole {
  MEMBER
  TEACHER
  ADMIN
}

enum ActivitySubmissionStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum ActivityDeliveryKind {
  TEXT
  FILE
  TEXT_AND_FILE
}

enum CommunityVoteKind {
  UP
}

enum CommunityPostKind {
  DISCUSSION
  PUBLICATION
}

enum LibraryItemKind {
  ARTICLE
  PDF
  GUIDE
  LINK
  VIDEO
}

enum MeetingKind {
  INDIVIDUAL
  LESSON
  GROUP
  WORKSHOP
  FEEDBACK
  OTHER
}

enum LessonAssetKind {
  VIDEO
  PDF
  IMAGE
  AUDIO
  FILE
  OTHER
}

enum LessonAssetScope {
  GENERAL
  INDIVIDUAL
}

enum AccessResourceType {
  COURSE
  MODULE
  LESSON
  ASSET
}

enum AccessPermission {
  VIEW
}

enum MigrationEntityType {
  COURSE
  MODULE
  LESSON
  ASSET
  STUDENT
}

enum MigrationStatus {
  DISCOVERED
  IMPORTED
  AMBIGUOUS
  FAILED
}

enum MigrationStudentMatchStatus {
  UNMATCHED
  EXACT
  AMBIGUOUS
}

model Member {
  id                     String                  @id
  displayName            String?
  email                  String?
  avatarUrl              String?
  role                   MemberRole              @default(MEMBER)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  profile                Profile?
  ownedAssets            LessonAsset[]           @relation("OwnedLessonAssets")
  accessGrants           AccessGrant[]
  migrationStudents      MigrationStudent[]      @relation("MigrationStudentMember")
  notifications          Notification[]          @relation("NotificationRecipient")
  notificationsAsActor   Notification[]          @relation("NotificationActor")
  mentionsSent           Mention[]               @relation("MentionActor")
  mentionsReceived       Mention[]               @relation("MentionTarget")
  notificationPreference NotificationPreference?
  topicFollows           TopicFollow[]
  activityAssignments    ActivityAssignment[]
  activitySubmissions    ActivitySubmission[]
  libraryBookmarks       LibraryBookmark[]
  meetingParticipations  MeetingParticipant[]

  @@index([role])
}

model Profile {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  username    String   @unique
  displayName String?
  avatarUrl   String?
  headline    String?
  bio         String?  @db.Text
  occupation  String?
  institution String?
  city        String?
  state       String?
  country     String?
  website     String?
  instagram   String?
  linkedin    String?
  interests   String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  member      Member   @relation(fields: [clerkUserId], references: [id], onDelete: Cascade)

  @@index([displayName])
}

model LearningPath {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?       @db.Text
  coverUrl    String?
  status      ContentStatus @default(DRAFT)
  position    Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  courses     Course[]

  @@index([status, position])
}

model Course {
  id              String        @id @default(cuid())
  title           String
  subtitle        String?       @db.Text
  slug            String        @unique
  description     String?       @db.Text
  coverUrl        String?
  format          String?
  category        String?
  level           String?
  durationMinutes Int?
  tags            String[]      @default([])
  teacherId       String?
  status          ContentStatus @default(DRAFT)
  position        Int           @default(0)
  publishedAt     DateTime?
  createdBy       String?
  updatedBy       String?
  learningPathId  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  learningPath    LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  modules         Module[]
  enrollments     Enrollment[]
  activities      Activity[]
  meetings        Meeting[]

  @@unique([learningPathId, position])
  @@index([status, position])
  @@index([learningPathId, status, position])
}

model Module {
  id          String        @id @default(cuid())
  title       String
  slug        String
  description String?       @db.Text
  objectives  String[]      @default([])
  position    Int           @default(0)
  status      ContentStatus @default(DRAFT)
  courseId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([courseId, slug])
  @@unique([courseId, position])
  @@index([status, courseId, position])
}

model Lesson {
  id           String           @id @default(cuid())
  title        String
  slug         String
  description  String?          @db.Text
  objectives   String[]         @default([])
  content      Json
  kind         LessonKind       @default(TEXT)
  status       ContentStatus    @default(DRAFT)
  position     Int              @default(0)
  publishedAt  DateTime?
  createdBy    String?
  updatedBy    String?
  moduleId     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  module       Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources    LessonResource[]
  libraryItems LibraryItem[]
  assets       LessonAsset[]
  progress     LessonProgress[]
  activities   Activity[]

  @@unique([moduleId, slug])
  @@unique([moduleId, position])
  @@index([status, moduleId, position])
}

model LessonResource {
  id        String       @id @default(cuid())
  title     String
  kind      ResourceKind
  url       String       @db.Text
  position  Int          @default(0)
  lessonId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  lesson    Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
}

model LessonAsset {
  id              String           @id @default(cuid())
  title           String
  kind            LessonAssetKind
  scope           LessonAssetScope @default(GENERAL)
  storagePath     String?          @db.Text
  externalUrl     String?          @db.Text
  mimeType        String?
  sizeBytes       BigInt?
  durationSeconds Int?
  checksum        String?
  sourcePlatform  String?
  sourceId        String?
  originalTitle   String?
  position        Int              @default(0)
  ownerMemberId   String?
  lessonId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lesson          Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  ownerMember     Member?          @relation("OwnedLessonAssets", fields: [ownerMemberId], references: [id], onDelete: SetNull)

  @@unique([lessonId, position])
  @@unique([sourcePlatform, sourceId])
  @@index([lessonId, kind, position])
  @@index([ownerMemberId, scope])
}

model Enrollment {
  id          String           @id @default(cuid())
  memberId    String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([memberId, courseId])
  @@index([courseId])
  @@index([memberId, status])
}

model AccessGrant {
  id             String             @id @default(cuid())
  memberId       String
  resourceType   AccessResourceType
  resourceId     String
  permission     AccessPermission   @default(VIEW)
  sourcePlatform String?
  sourceId       String?
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  member         Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, resourceType, resourceId])
  @@index([resourceType, resourceId])
  @@index([memberId, expiresAt])
}

model MigrationRecord {
  id             String              @id @default(cuid())
  sourcePlatform String
  entityType     MigrationEntityType
  sourceId       String
  targetId       String?
  status         MigrationStatus     @default(DISCOVERED)
  checksum       String?
  metadata       Json?
  lastError      String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([sourcePlatform, entityType, sourceId])
  @@index([status, sourcePlatform])
  @@index([targetId])
}

model MigrationStudent {
  id             String                      @id @default(cuid())
  sourcePlatform String
  sourceId       String
  displayName    String
  email          String?
  memberId       String?
  matchStatus    MigrationStudentMatchStatus @default(UNMATCHED)
  notes          String?                     @db.Text
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  member         Member?                     @relation("MigrationStudentMember", fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([sourcePlatform, sourceId])
  @@index([email])
  @@index([memberId])
  @@index([matchStatus])
}

model LessonProgress {
  id          String         @id @default(cuid())
  memberId    String
  lessonId    String
  status      ProgressStatus @default(IN_PROGRESS)
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([memberId, lessonId])
  @@index([lessonId])
  @@index([memberId, status])
}

model Activity {
  id                   String               @id @default(cuid())
  title                String
  slug                 String               @unique
  prompt               String               @db.Text
  instructions         String?              @db.Text
  deliveryKind         ActivityDeliveryKind @default(TEXT)
  status               ContentStatus        @default(DRAFT)
  position             Int                  @default(0)
  dueAt                DateTime?
  courseId             String?
  lessonId             String?
  relatedLibraryItemId String?
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  course               Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson               Lesson?              @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  submissions          ActivitySubmission[]
  assignments          ActivityAssignment[]
  meetings             Meeting[]            @relation("MeetingActivity")
  relatedLibraryItem   LibraryItem?         @relation("ActivityLibraryItem", fields: [relatedLibraryItemId], references: [id], onDelete: SetNull)

  @@index([status, position])
  @@index([courseId, status, position])
  @@index([lessonId, status])
  @@index([relatedLibraryItemId])
}

model ActivitySubmission {
  id                  String                   @id @default(cuid())
  activityId          String
  memberId            String
  content             String                   @db.Text
  status              ActivitySubmissionStatus @default(DRAFT)
  attachmentPath      String?                  @db.Text
  attachmentName      String?
  attachmentMimeType  String?
  attachmentSizeBytes BigInt?
  submittedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  activity            Activity                 @relation(fields: [activityId], references: [id], onDelete: Cascade)
  member              Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  feedback            Feedback?

  @@unique([activityId, memberId])
  @@index([memberId, status, updatedAt])
  @@index([activityId, status])
}

model ActivityAssignment {
  id         String    @id @default(cuid())
  activityId String
  memberId   String
  dueAt      DateTime?
  assignedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  activity   Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([activityId, memberId])
  @@index([memberId, dueAt])
  @@index([activityId, dueAt])
}

model Feedback {
  id           String             @id @default(cuid())
  submissionId String             @unique
  teacherId    String
  content      String             @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  submission   ActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Notification {
  id               String    @id @default(cuid())
  memberId         String
  actorId          String?
  type             String
  entityType       String?
  entityId         String?
  parentEntityType String?
  parentEntityId   String?
  metadata         Json?
  groupKey         String?
  dedupeKey        String?   @unique
  priority         Int       @default(0)
  title            String
  body             String?   @db.Text
  href             String?   @db.Text
  seenAt           DateTime?
  readAt           DateTime?
  createdAt        DateTime  @default(now())
  member           Member    @relation("NotificationRecipient", fields: [memberId], references: [id], onDelete: Cascade)
  actor            Member?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([memberId, readAt, createdAt])
  @@index([memberId, seenAt, createdAt])
  @@index([memberId, type, createdAt])
  @@index([groupKey, createdAt])
}

model Mention {
  id              String   @id @default(cuid())
  actorId         String
  mentionedUserId String
  entityType      String
  entityId        String
  createdAt       DateTime @default(now())
  actor           Member   @relation("MentionActor", fields: [actorId], references: [id], onDelete: Cascade)
  mentionedUser   Member   @relation("MentionTarget", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([actorId, mentionedUserId, entityType, entityId])
  @@index([mentionedUserId, createdAt])
  @@index([entityType, entityId])
}

model NotificationPreference {
  id                    String   @id @default(cuid())
  memberId              String   @unique
  mentions              Boolean  @default(true)
  commentReplies        Boolean  @default(true)
  topicComments         Boolean  @default(true)
  followedTopicActivity Boolean  @default(true)
  lessonAvailable       Boolean  @default(true)
  moduleAvailable       Boolean  @default(true)
  activityAssigned      Boolean  @default(true)
  feedbackReceived      Boolean  @default(true)
  activityDeadline      Boolean  @default(true)
  announcements         Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  member                Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model TopicFollow {
  id        String        @id @default(cuid())
  userId    String
  topicId   String
  createdAt DateTime      @default(now())
  mutedAt   DateTime?
  user      Member        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     CommunityPost @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([topicId, mutedAt, createdAt])
  @@index([userId, mutedAt, createdAt])
}

model CommunitySpace {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  description    String?         @db.Text
  icon           String?
  commentsClosed Boolean         @default(false)
  status         ContentStatus   @default(DRAFT)
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  posts          CommunityPost[]

  @@index([status, position])
}

model CommunityPost {
  id          String              @id @default(cuid())
  spaceId     String?
  authorId    String
  kind        CommunityPostKind   @default(DISCUSSION)
  title       String
  subtitle    String?             @db.Text
  slug        String?             @unique
  content     String              @db.Text
  excerpt     String?             @db.Text
  contentJson Json?
  tags        String[]            @default([])
  coverUrl    String?
  status      ContentStatus       @default(PUBLISHED)
  isPinned    Boolean             @default(false)
  isFeatured  Boolean             @default(false)
  featuredAt  DateTime?
  publishedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  space       CommunitySpace?     @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  comments    CommunityComment[]
  votes       PostVote[]
  bookmarks   CommunityBookmark[]
  followers   TopicFollow[]

  @@index([spaceId, status, createdAt])
  @@index([kind, status, createdAt])
  @@index([status, publishedAt, createdAt])
  @@index([authorId, createdAt])
  @@index([isPinned, status, createdAt])
}

model CommunityBookmark {
  id        String        @id @default(cuid())
  postId    String
  memberId  String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, memberId])
  @@index([memberId, createdAt])
}

model CommunityComment {
  id          String             @id @default(cuid())
  postId      String
  authorId    String
  parentId    String?
  content     String             @db.Text
  contentJson Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  post        CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent      CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies     CommunityComment[] @relation("CommentReplies")
  votes       CommentVote[]

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@index([authorId, createdAt])
}

model PostVote {
  id        String            @id @default(cuid())
  postId    String
  memberId  String
  kind      CommunityVoteKind @default(UP)
  createdAt DateTime          @default(now())
  post      CommunityPost     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, memberId])
  @@index([memberId, createdAt])
}

model CommentVote {
  id        String            @id @default(cuid())
  commentId String
  memberId  String
  kind      CommunityVoteKind @default(UP)
  createdAt DateTime          @default(now())
  comment   CommunityComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, memberId])
  @@index([memberId, createdAt])
}

model Meeting {
  id                   String               @id @default(cuid())
  title                String
  description          String?              @db.Text
  startsAt             DateTime
  endsAt               DateTime?
  timezone             String               @default("America/Sao_Paulo")
  joinUrl              String               @db.Text
  recordingUrl         String?              @db.Text
  status               ContentStatus        @default(DRAFT)
  teacherId            String?
  courseId             String?
  position             Int                  @default(0)
  kind                 MeetingKind          @default(OTHER)
  recurrenceRule       String?
  demoKey              String?              @unique
  relatedActivityId    String?
  relatedLibraryItemId String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  course               Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  relatedActivity      Activity?            @relation("MeetingActivity", fields: [relatedActivityId], references: [id], onDelete: SetNull)
  relatedLibraryItem   LibraryItem?         @relation("MeetingLibraryItem", fields: [relatedLibraryItemId], references: [id], onDelete: SetNull)
  participants         MeetingParticipant[]

  @@index([status, startsAt])
  @@index([teacherId, startsAt])
  @@index([courseId, startsAt])
  @@index([relatedActivityId])
  @@index([relatedLibraryItemId])
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meetingId String
  memberId  String
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([meetingId, memberId])
  @@index([memberId, meetingId])
}

model LibraryItem {
  id          String            @id @default(cuid())
  title       String
  description String?           @db.Text
  kind        LibraryItemKind
  category    String?
  tags        String[]
  url         String            @db.Text
  authors     String?           @db.Text
  year        Int?
  doi         String?
  pmid        String?
  storagePath String?           @db.Text
  mimeType    String?
  sizeBytes   BigInt?
  status      ContentStatus     @default(DRAFT)
  position    Int               @default(0)
  createdBy   String?
  updatedBy   String?
  lessonId    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  bookmarks   LibraryBookmark[]
  meetings    Meeting[]         @relation("MeetingLibraryItem")
  lesson      Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  activities  Activity[]        @relation("ActivityLibraryItem")

  @@index([status, category, position])
  @@index([status, createdAt])
  @@index([lessonId])
}

model LibraryBookmark {
  id        String      @id @default(cuid())
  itemId    String
  memberId  String
  createdAt DateTime    @default(now())
  item      LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  member    Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([itemId, memberId])
  @@index([memberId, createdAt])
}
