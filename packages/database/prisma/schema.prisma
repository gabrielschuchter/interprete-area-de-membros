// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseExperience {
  ASYNC
  RECORDING_ARCHIVE
}

enum LessonKind {
  TEXT
  VIDEO
  READING
  MIXED
  MATERIAL
}

enum ResourceKind {
  PDF
  ARTICLE
  EXTERNAL_LINK
  FILE
  RECOMMENDED_READING
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum MemberRole {
  MEMBER
  TEACHER
  ADMIN
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ActivitySubmissionStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum ActivityDeliveryKind {
  TEXT
  FILE
  TEXT_AND_FILE
}

enum CommunityVoteKind {
  UP
}

enum CommunitySpaceVisibility {
  PUBLIC
  PRIVATE
}

enum CommunitySpaceMemberRole {
  OWNER
  MEMBER
}

enum CommunitySpaceInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum LearningAssignmentTargetType {
  ACTIVITY
  COURSE
  MODULE
  LESSON
  ASSET
  RECORDING
  LIBRARY_ITEM
  EXERCISE_LIST
}

enum LearningAssignmentAudienceType {
  INDIVIDUAL
  SELECTED_MEMBERS
  GROUP
  ALL_MEMBERS
}

enum ExerciseQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum ExerciseSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ExerciseSessionKind {
  LIST
  FAVORITE
}

enum StudyActivityKind {
  LESSON
  RECORDING
  EXERCISE
  ACTIVITY
  COMMUNITY
  LIBRARY_ITEM
}

enum StudyGoalPeriod {
  WEEKLY
  MONTHLY
}

enum LearningTaskRecurrence {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

enum BadgeCriterion {
  STUDY_MINUTES
  STUDY_STREAK_DAYS
  STUDY_GOALS_MET
  EXERCISE_ANSWERS
  ACTIVITIES_COMPLETED
  COMMUNITY_PUBLICATIONS
  LESSONS_COMPLETED
  TASKS_COMPLETED
  LEARNING_PATHS_COMPLETED
  MEETINGS_ATTENDED
}

enum LearningAssignmentStatus {
  NEW
  VIEWED
  STARTED
  COMPLETED
  REVOKED
}

enum CommunityPostKind {
  DISCUSSION
  PUBLICATION
  QUESTION
  CASE
  ARTICLE
  RESOURCE
}

enum LibraryItemKind {
  ARTICLE
  PDF
  GUIDE
  LINK
  VIDEO
}

enum LibraryItemDifficulty {
  INTRODUCTORY
  INTERMEDIATE
  ADVANCED
}

enum LibraryItemAccessType {
  OPEN_ACCESS
  FREE_TO_READ
  FREE_TOOL
}

enum LibraryBookmarkTargetType {
  LIBRARY_ITEM
  COURSE
  MODULE
  LESSON
  ASSET
}

enum AnnouncementAudience {
  ALL
  STAFF
  SELECTED
}

enum MeetingKind {
  INDIVIDUAL
  LESSON
  GROUP
  WORKSHOP
  FEEDBACK
  OTHER
}

enum LessonAssetKind {
  VIDEO
  PDF
  IMAGE
  AUDIO
  FILE
  OTHER
}

enum LessonAssetScope {
  GENERAL
  INDIVIDUAL
}

enum LessonAssetMediaProvider {
  STORAGE
  YOUTUBE
  EXTERNAL_URL
}

enum AccessResourceType {
  COURSE
  MODULE
  LESSON
  ASSET
}

enum AccessPermission {
  VIEW
}

enum MigrationEntityType {
  COURSE
  MODULE
  LESSON
  ASSET
  STUDENT
}

enum MigrationStatus {
  DISCOVERED
  IMPORTED
  AMBIGUOUS
  FAILED
}

enum MigrationStudentMatchStatus {
  UNMATCHED
  EXACT
  AMBIGUOUS
}

enum OutboxJobStatus {
  PENDING
  PROCESSING
  RETRY
  SUCCEEDED
  DEAD
}

enum ImportedRecordingGroupAssignmentAction {
  ASSIGNED
  REASSIGNED
  REVOKED
}

enum CollectionItemType {
  LESSON
  COURSE
  EXERCISE_LIST
  RECORDING
  LIBRARY_ITEM
}

enum HomeBlockType {
  NEXT_MEETING
  PREPARATION
  CONTINUE_WATCHING
  PENDING_ACTIVITY
  FEEDBACK
  ASYNC_LEARNING
  COMMUNITY
  COLLECTION
}

model Member {
  id                                  String                             @id
  displayName                         String?
  email                               String?
  avatarUrl                           String?
  role                                MemberRole                         @default(MEMBER)
  onboardingStatus                    OnboardingStatus                   @default(NOT_STARTED)
  onboardingStep                      Int                                @default(0)
  onboardingVersion                   Int                                @default(1)
  onboardingStartedAt                 DateTime?
  onboardingCompletedAt               DateTime?
  deactivatedAt                       DateTime?
  createdAt                           DateTime                           @default(now())
  updatedAt                           DateTime                           @updatedAt
  profile                             Profile?
  ownedAssets                         LessonAsset[]                      @relation("OwnedLessonAssets")
  accessGrants                        AccessGrant[]
  migrationStudents                   MigrationStudent[]                 @relation("MigrationStudentMember")
  notifications                       Notification[]                     @relation("NotificationRecipient")
  notificationsAsActor                Notification[]                     @relation("NotificationActor")
  mentionsSent                        Mention[]                          @relation("MentionActor")
  mentionsReceived                    Mention[]                          @relation("MentionTarget")
  notificationPreference              NotificationPreference?
  topicFollows                        TopicFollow[]
  mutationRateLimits                  MutationRateLimit[]
  activitySubmissions                 ActivitySubmission[]
  libraryBookmarks                    LibraryBookmark[]
  meetingParticipations               MeetingParticipant[]
  meetingAttendance                   MeetingAttendance[]                @relation("MeetingAttendanceMember")
  meetingAttendanceMarked             MeetingAttendance[]                @relation("MeetingAttendanceMarker")
  playbackProgress                    PlaybackProgress[]
  importedRecordingGroups             ImportedRecordingGroup[]           @relation("ImportedRecordingGroupMember")
  recordingGroupAssignmentsAsMember   ImportedRecordingGroupAssignment[] @relation("ImportedRecordingGroupMemberTarget")
  recordingGroupAssignmentsAsPrevious ImportedRecordingGroupAssignment[] @relation("ImportedRecordingGroupPreviousMember")
  recordingGroupAssignmentsBy         ImportedRecordingGroupAssignment[] @relation("ImportedRecordingGroupChangedBy")
  recordingGroupAssignmentsAsAssigner ImportedRecordingGroup[]           @relation("ImportedRecordingGroupAssignedBy")
  productSettingsUpdated              ProductSetting[]                   @relation("ProductSettingUpdatedBy")
  homeBlocksCreated                   HomeBlockConfiguration[]           @relation("HomeBlockCreatedBy")
  homeBlocksUpdated                   HomeBlockConfiguration[]           @relation("HomeBlockUpdatedBy")
  contentCollectionsCreated           ContentCollection[]                @relation("ContentCollectionCreatedBy")
  contentCollectionsUpdated           ContentCollection[]                @relation("ContentCollectionUpdatedBy")
  communitySpacesOwned                CommunitySpace[]                   @relation("CommunitySpaceOwner")
  communitySpaceMemberships           CommunitySpaceMember[]
  communitySpaceInvitationsReceived   CommunitySpaceInvitation[]         @relation("CommunitySpaceInvitationRecipient")
  communitySpaceInvitationsSent       CommunitySpaceInvitation[]         @relation("CommunitySpaceInvitationSender")
  learningAssignmentBatchesCreated    LearningAssignmentBatch[]          @relation("LearningAssignmentBatchCreator")
  learningAssignmentsReceived         ActivityAssignment[]               @relation("LearningAssignmentRecipient")
  learningAssignmentsCreated          ActivityAssignment[]               @relation("LearningAssignmentAssigner")
  libraryItemViews                    LibraryItemView[]
  announcementsCreated                Announcement[]                     @relation("AnnouncementCreator")
  exerciseBanksCreated                ExerciseBank[]                     @relation("ExerciseBankCreator")
  exerciseListsCreated                ExerciseList[]                     @relation("ExerciseListCreator")
  exerciseSessions                    ExerciseSession[]
  exerciseQuestionBookmarks           ExerciseQuestionBookmark[]
  studyTrackingSessions               StudyTrackingSession[]
  studyActivityIntervals              StudyActivityInterval[]
  studyGoals                          StudyGoal[]
  learningTasksCreated                LearningTask[]                     @relation("LearningTaskCreator")
  learningTaskAssignments             LearningTaskRecipient[]
  learningTaskCompletions             LearningTaskCompletion[]
  studyCampaignsCreated               StudyCampaign[]                    @relation("StudyCampaignCreator")
  badgeAwards                         BadgeAward[]
  badgeEvaluationState                BadgeEvaluationState?
  studyGoalAchievements               StudyGoalAchievement[]
  badgeDefinitionsCreated             BadgeDefinition[]                  @relation("BadgeDefinitionCreator")
  badgeDefinitionRevisionsCreated     BadgeDefinitionRevision[]          @relation("BadgeRevisionCreator")

  @@index([role])
  @@index([onboardingStatus], map: "Member_onboardingStatus_idx")
}

model Profile {
  id              String   @id @default(cuid())
  clerkUserId     String   @unique
  username        String   @unique
  showInDirectory Boolean  @default(true)
  displayName     String?
  avatarUrl       String?
  headline        String?
  bio             String?  @db.Text
  occupation      String?
  institution     String?
  city            String?
  state           String?
  country         String?
  website         String?
  instagram       String?
  linkedin        String?
  interests       String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  member          Member   @relation(fields: [clerkUserId], references: [id], onDelete: Cascade)

  @@index([displayName])
}

model LearningPath {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?       @db.Text
  coverUrl    String?
  status      ContentStatus @default(DRAFT)
  position    Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  courses     Course[]

  @@index([status, position])
}

model Course {
  id               String                  @id @default(cuid())
  title            String
  subtitle         String?                 @db.Text
  slug             String                  @unique
  description      String?                 @db.Text
  coverUrl         String?
  format           String?
  category         String?
  level            String?
  durationMinutes  Int?
  tags             String[]                @default([])
  experience       CourseExperience        @default(ASYNC)
  teacherId        String?
  status           ContentStatus           @default(DRAFT)
  position         Int                     @default(0)
  publishedAt      DateTime?
  createdBy        String?
  updatedBy        String?
  learningPathId   String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  learningPath     LearningPath?           @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  modules          Module[]
  enrollments      Enrollment[]
  activities       Activity[]
  meetings         Meeting[]
  libraryBookmarks LibraryBookmark[]
  collectionItems  ContentCollectionItem[]

  @@unique([learningPathId, position])
  @@index([status, position])
  @@index([learningPathId, status, position])
}

model Module {
  id                      String                   @id @default(cuid())
  title                   String
  slug                    String
  description             String?                  @db.Text
  objectives              String[]                 @default([])
  position                Int                      @default(0)
  status                  ContentStatus            @default(DRAFT)
  courseId                String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  course                  Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons                 Lesson[]
  importedRecordingGroups ImportedRecordingGroup[]
  libraryBookmarks        LibraryBookmark[]

  @@unique([courseId, slug])
  @@unique([courseId, position])
  @@index([status, courseId, position])
}

model Lesson {
  id                 String                  @id @default(cuid())
  title              String
  slug               String
  description        String?                 @db.Text
  objectives         String[]                @default([])
  content            Json
  kind               LessonKind              @default(TEXT)
  status             ContentStatus           @default(DRAFT)
  position           Int                     @default(0)
  publishedAt        DateTime?
  createdBy          String?
  updatedBy          String?
  moduleId           String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  module             Module                  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources          LessonResource[]
  libraryItems       LibraryItem[]
  assets             LessonAsset[]
  progress           LessonProgress[]
  activities         Activity[]
  importedRecordings ImportedRecording[]
  collectionItems    ContentCollectionItem[]
  libraryBookmarks   LibraryBookmark[]

  @@unique([moduleId, slug])
  @@unique([moduleId, position])
  @@index([status, moduleId, position])
}

model LessonResource {
  id        String       @id @default(cuid())
  title     String
  kind      ResourceKind
  url       String       @db.Text
  position  Int          @default(0)
  lessonId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  lesson    Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
}

model LessonAsset {
  id                String                   @id @default(cuid())
  title             String
  kind              LessonAssetKind
  scope             LessonAssetScope         @default(GENERAL)
  mediaProvider     LessonAssetMediaProvider @default(STORAGE)
  mediaExternalId   String?                  @db.VarChar(64)
  storagePath       String?                  @db.Text
  externalUrl       String?                  @db.Text
  mimeType          String?
  sizeBytes         BigInt?
  durationSeconds   Int?
  checksum          String?
  sourcePlatform    String?
  sourceId          String?
  originalTitle     String?
  position          Int                      @default(0)
  ownerMemberId     String?
  lessonId          String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  lesson            Lesson                   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  ownerMember       Member?                  @relation("OwnedLessonAssets", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  importedRecording ImportedRecording?
  playbackProgress  PlaybackProgress[]
  collectionItems   ContentCollectionItem[]
  libraryBookmarks  LibraryBookmark[]

  @@unique([lessonId, position])
  @@unique([sourcePlatform, sourceId])
  @@index([lessonId, kind, position])
  @@index([ownerMemberId, scope])
}

model Enrollment {
  id          String           @id @default(cuid())
  memberId    String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([memberId, courseId])
  @@index([courseId])
  @@index([memberId, status])
}

model AccessGrant {
  id             String             @id @default(cuid())
  memberId       String
  resourceType   AccessResourceType
  resourceId     String
  permission     AccessPermission   @default(VIEW)
  sourcePlatform String?
  sourceId       String?
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  member         Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, resourceType, resourceId])
  @@index([resourceType, resourceId])
  @@index([memberId, expiresAt])
}

model MigrationRecord {
  id             String              @id @default(cuid())
  sourcePlatform String
  entityType     MigrationEntityType
  sourceId       String
  targetId       String?
  status         MigrationStatus     @default(DISCOVERED)
  checksum       String?
  metadata       Json?
  lastError      String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([sourcePlatform, entityType, sourceId])
  @@index([status, sourcePlatform])
  @@index([targetId])
}

model MigrationStudent {
  id                      String                      @id @default(cuid())
  sourcePlatform          String
  sourceId                String
  displayName             String
  email                   String?
  memberId                String?
  matchStatus             MigrationStudentMatchStatus @default(UNMATCHED)
  notes                   String?                     @db.Text
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  member                  Member?                     @relation("MigrationStudentMember", fields: [memberId], references: [id], onDelete: SetNull)
  importedRecordingGroups ImportedRecordingGroup[]

  @@unique([sourcePlatform, sourceId])
  @@index([email])
  @@index([memberId])
  @@index([matchStatus])
}

model ImportedRecordingGroup {
  id                 String                             @id @default(cuid())
  sourcePlatform     String
  sourceId           String
  legacyStudentName  String
  legacyStudentId    String?
  legacyModuleId     String                             @unique
  memberId           String?
  assignedAt         DateTime?
  assignedByMemberId String?
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt
  legacyStudent      MigrationStudent?                  @relation(fields: [legacyStudentId], references: [id], onDelete: SetNull)
  legacyModule       Module                             @relation(fields: [legacyModuleId], references: [id], onDelete: Restrict)
  member             Member?                            @relation("ImportedRecordingGroupMember", fields: [memberId], references: [id], onDelete: SetNull)
  assignedByMember   Member?                            @relation("ImportedRecordingGroupAssignedBy", fields: [assignedByMemberId], references: [id], onDelete: SetNull)
  recordings         ImportedRecording[]
  assignments        ImportedRecordingGroupAssignment[]

  @@unique([sourcePlatform, sourceId])
  @@index([memberId, updatedAt])
  @@index([legacyStudentId])
}

model ImportedRecording {
  id                 String                  @id @default(cuid())
  groupId            String
  assetId            String                  @unique
  legacyLessonId     String
  meetingId          String?
  sourcePlatform     String
  sourceId           String
  originalTitle      String?
  meetingDate        DateTime?
  thumbnailPath      String?
  thumbnailMimeType  String?
  thumbnailSizeBytes Int?
  thumbnailWidth     Int?
  thumbnailHeight    Int?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  group              ImportedRecordingGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  asset              LessonAsset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  legacyLesson       Lesson                  @relation(fields: [legacyLessonId], references: [id], onDelete: Restrict)
  meeting            Meeting?                @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  collectionItems    ContentCollectionItem[]

  @@unique([sourcePlatform, sourceId])
  @@index([groupId, meetingDate])
  @@index([meetingId, meetingDate])
  @@index([legacyLessonId])
}

model ImportedRecordingGroupAssignment {
  id                String                                 @id @default(cuid())
  groupId           String
  previousMemberId  String?
  memberId          String?
  changedByMemberId String
  action            ImportedRecordingGroupAssignmentAction
  note              String?                                @db.Text
  createdAt         DateTime                               @default(now())
  group             ImportedRecordingGroup                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  previousMember    Member?                                @relation("ImportedRecordingGroupPreviousMember", fields: [previousMemberId], references: [id], onDelete: SetNull)
  member            Member?                                @relation("ImportedRecordingGroupMemberTarget", fields: [memberId], references: [id], onDelete: SetNull)
  changedBy         Member                                 @relation("ImportedRecordingGroupChangedBy", fields: [changedByMemberId], references: [id], onDelete: Restrict)

  @@index([groupId, createdAt])
  @@index([memberId, createdAt])
}

model PlaybackProgress {
  id                  String      @id @default(cuid())
  memberId            String
  assetId             String
  positionSeconds     Int         @default(0)
  durationSeconds     Int?
  lastViewedAt        DateTime    @default(now())
  completedPlaybackAt DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  member              Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  asset               LessonAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([memberId, assetId])
  @@index([memberId, lastViewedAt])
  @@index([assetId, lastViewedAt])
}

model LessonProgress {
  id          String         @id @default(cuid())
  memberId    String
  lessonId    String
  status      ProgressStatus @default(IN_PROGRESS)
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([memberId, lessonId])
  @@index([lessonId])
  @@index([memberId, status])
}

model Activity {
  id                   String               @id @default(cuid())
  idempotencyKey       String?
  title                String
  slug                 String               @unique
  prompt               String               @db.Text
  instructions         String?              @db.Text
  deliveryKind         ActivityDeliveryKind @default(TEXT)
  status               ContentStatus        @default(DRAFT)
  position             Int                  @default(0)
  dueAt                DateTime?
  courseId             String?
  lessonId             String?
  relatedLibraryItemId String?
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  course               Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson               Lesson?              @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  submissions          ActivitySubmission[]
  assignments          ActivityAssignment[]
  meetings             Meeting[]            @relation("MeetingActivity")
  relatedLibraryItem   LibraryItem?         @relation("ActivityLibraryItem", fields: [relatedLibraryItemId], references: [id], onDelete: SetNull)

  @@unique([createdBy, idempotencyKey])
  @@index([status, position])
  @@index([courseId, status, position])
  @@index([lessonId, status])
  @@index([relatedLibraryItemId])
}

model ActivitySubmission {
  id                  String                   @id @default(cuid())
  activityId          String
  memberId            String
  content             String                   @db.Text
  status              ActivitySubmissionStatus @default(DRAFT)
  attachmentPath      String?                  @db.Text
  attachmentName      String?
  attachmentMimeType  String?
  attachmentSizeBytes BigInt?
  submittedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  activity            Activity                 @relation(fields: [activityId], references: [id], onDelete: Cascade)
  member              Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  feedback            Feedback?

  @@unique([activityId, memberId])
  @@index([memberId, status, updatedAt])
  @@index([activityId, status])
}

model ActivityAssignment {
  id                 String                       @id @default(cuid())
  activityId         String?
  targetType         LearningAssignmentTargetType @default(ACTIVITY)
  targetId           String
  batchId            String?
  memberId           String
  assignedByMemberId String?
  message            String?                      @db.Text
  availableAt        DateTime?
  dueAt              DateTime?
  expiresAt          DateTime?
  status             LearningAssignmentStatus     @default(NEW)
  viewedAt           DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  revokedAt          DateTime?
  assignedAt         DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  activity           Activity?                    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  batch              LearningAssignmentBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  member             Member                       @relation("LearningAssignmentRecipient", fields: [memberId], references: [id], onDelete: Cascade)
  assignedBy         Member?                      @relation("LearningAssignmentAssigner", fields: [assignedByMemberId], references: [id], onDelete: SetNull)

  @@unique([batchId, targetType, targetId, memberId])
  @@index([memberId, dueAt])
  @@index([activityId, dueAt])
  @@index([memberId, status, assignedAt])
  @@index([targetType, targetId, status])
  @@index([batchId, memberId])
}

model LearningAssignmentBatch {
  id                String                         @id @default(cuid())
  idempotencyKey    String?
  targetType        LearningAssignmentTargetType
  targetId          String
  audienceType      LearningAssignmentAudienceType
  audienceSpaceId   String?
  createdByMemberId String?
  message           String?                        @db.Text
  availableAt       DateTime?
  dueAt             DateTime?
  expiresAt         DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  audienceSpace     CommunitySpace?                @relation(fields: [audienceSpaceId], references: [id], onDelete: SetNull)
  createdBy         Member?                        @relation("LearningAssignmentBatchCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  assignments       ActivityAssignment[]

  @@unique([createdByMemberId, idempotencyKey])
  @@index([targetType, targetId, createdAt])
  @@index([createdByMemberId, createdAt])
  @@index([audienceSpaceId, createdAt])
}

model Feedback {
  id           String             @id @default(cuid())
  submissionId String             @unique
  teacherId    String
  content      String             @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  submission   ActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Notification {
  id               String    @id @default(cuid())
  memberId         String
  actorId          String?
  type             String
  entityType       String?
  entityId         String?
  parentEntityType String?
  parentEntityId   String?
  metadata         Json?
  groupKey         String?
  dedupeKey        String?   @unique
  priority         Int       @default(0)
  title            String
  body             String?   @db.Text
  href             String?   @db.Text
  seenAt           DateTime?
  readAt           DateTime?
  createdAt        DateTime  @default(now())
  member           Member    @relation("NotificationRecipient", fields: [memberId], references: [id], onDelete: Cascade)
  actor            Member?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([memberId, readAt, createdAt])
  @@index([memberId, seenAt, createdAt])
  @@index([memberId, type, createdAt])
  @@index([groupKey, createdAt])
}

model Mention {
  id              String   @id @default(cuid())
  actorId         String
