  ASSIGNED
  REASSIGNED
  REVOKED
}

enum CollectionItemType {
  LESSON
  COURSE
  EXERCISE_LIST
  RECORDING
  LIBRARY_ITEM
}

enum HomeBlockType {
  NEXT_MEETING
  PREPARATION
  CONTINUE_WATCHING
  PENDING_ACTIVITY
  FEEDBACK
  ASYNC_LEARNING
  COMMUNITY
  COLLECTION
}

model Member {
  id                                     String                             @id
  displayName                            String?
  email                                  String?
  avatarUrl                              String?
  role                                   MemberRole                         @default(MEMBER)
  onboardingStatus                       OnboardingStatus                   @default(NOT_STARTED)
  onboardingStep                         Int                                @default(0)
  onboardingVersion                      Int                                @default(1)
  gestaoWelcomeSeenAt                    DateTime?
  onboardingStartedAt                    DateTime?
  onboardingCompletedAt                  DateTime?
  deactivatedAt                          DateTime?
  createdAt                              DateTime                           @default(now())
  updatedAt                              DateTime                           @updatedAt
  profile                                Profile?
  ownedAssets                            LessonAsset[]                      @relation("OwnedLessonAssets")
  accessGrants                           AccessGrant[]
  cohortsCreated                         Cohort[]                           @relation("CohortCreator")
  cohortTeaching                         CohortTeacher[]                    @relation("CohortTeacherMember")
  cohortAssignments                      CohortTeacher[]                    @relation("CohortTeacherAssigner")
  cohortMemberships                      CohortMembership[]
  cohortInvitesCreated                   CohortInvite[]                     @relation("CohortInviteCreator")
  accessGrantSourcesAsMember             AccessGrantSource[]                @relation("AccessGrantSourceMember")
  accessGrantSourcesAsCreator            AccessGrantSource[]                @relation("AccessGrantSourceCreator")
  cohortCourseAccessesCreated            CohortCourseAccess[]               @relation("CohortCourseAccessCreator")
  cohortLessonReleasesUpdated            CohortLessonRelease[]              @relation("CohortLessonReleaseUpdater")
  cohortEventsCreated                    CohortEvent[]                      @relation("CohortEventCreator")
  cohortEventOccurrenceExceptionsUpdated CohortEventOccurrenceException[]   @relation("CohortEventOccurrenceExceptionUpdater")
  cohortCalendarFeeds                    CohortCalendarFeed[]
  meetingCohortTargetsCreated            MeetingCohortTarget[]              @relation("MeetingCohortTargetCreator")
  meetingOccurrenceExceptionsUpdated     MeetingOccurrenceException[]       @relation("MeetingOccurrenceExceptionUpdater")
  activityCohortTargetsCreated           ActivityCohortTarget[]             @relation("ActivityCohortTargetCreator")
  activityFeedbackDrafts                 ActivityFeedbackDraft[]            @relation("ActivityFeedbackDraftReviewer")
  cohortMembershipsCreated               CohortMembership[]                 @relation("CohortMembershipCreator")
  migrationStudents                      MigrationStudent[]                 @relation("MigrationStudentMember")
  notifications                          Notification[]                     @relation("NotificationRecipient")
  notificationsAsActor                   Notification[]                     @relation("NotificationActor")
  mentionsSent                           Mention[]                          @relation("MentionActor")
  mentionsReceived                       Mention[]                          @relation("MentionTarget")
  notificationPreference                 NotificationPreference?
  topicFollows                           TopicFollow[]
  mutationRateLimits                     MutationRateLimit[]
  activitySubmissions                    ActivitySubmission[]
  libraryBookmarks                       LibraryBookmark[]
  meetingParticipations                  MeetingParticipant[]
  meetingAttendance                      MeetingAttendance[]                @relation("MeetingAttendanceMember")
  meetingAttendanceMarked                MeetingAttendance[]                @relation("MeetingAttendanceMarker")
  playbackProgress                       PlaybackProgress[]
  importedRecordingGroups                ImportedRecordingGroup[]           @relation("ImportedRecordingGroupMember")
  recordingGroupAssignmentsAsMember      ImportedRecordingGroupAssignment[] @relation("ImportedRecordingGroupMemberTarget")
  recordingGroupAssignmentsAsPrevious    ImportedRecordingGroupAssignment[] @relation("ImportedRecordingGroupPreviousMember")
  recordingGroupAssignmentsBy            ImportedRecordingGroupAssignment[] @relation("ImportedRecordingGroupChangedBy")
  recordingGroupAssignmentsAsAssigner    ImportedRecordingGroup[]           @relation("ImportedRecordingGroupAssignedBy")
  productSettingsUpdated                 ProductSetting[]                   @relation("ProductSettingUpdatedBy")
  homeBlocksCreated                      HomeBlockConfiguration[]           @relation("HomeBlockCreatedBy")
  homeBlocksUpdated                      HomeBlockConfiguration[]           @relation("HomeBlockUpdatedBy")
  contentCollectionsCreated              ContentCollection[]                @relation("ContentCollectionCreatedBy")
  contentCollectionsUpdated              ContentCollection[]                @relation("ContentCollectionUpdatedBy")
  communitySpacesOwned                   CommunitySpace[]                   @relation("CommunitySpaceOwner")
  communitySpaceMemberships              CommunitySpaceMember[]
  communitySpaceInvitationsReceived      CommunitySpaceInvitation[]         @relation("CommunitySpaceInvitationRecipient")
  communitySpaceInvitationsSent          CommunitySpaceInvitation[]         @relation("CommunitySpaceInvitationSender")
  communitySpaceInviteLinksCreated       CommunitySpaceInviteLink[]         @relation("CommunitySpaceInviteLinkCreator")
  communityPostShareLinksCreated         CommunityPostShareLink[]           @relation("CommunityPostShareLinkCreator")
  learningAssignmentBatchesCreated       LearningAssignmentBatch[]          @relation("LearningAssignmentBatchCreator")
  learningAssignmentsReceived            ActivityAssignment[]               @relation("LearningAssignmentRecipient")
  learningAssignmentsCreated             ActivityAssignment[]               @relation("LearningAssignmentAssigner")
  libraryItemViews                       LibraryItemView[]
  announcementsCreated                   Announcement[]                     @relation("AnnouncementCreator")
  announcementDismissals                 AnnouncementDismissal[]
  exerciseBanksCreated                   ExerciseBank[]                     @relation("ExerciseBankCreator")
  exerciseListsCreated                   ExerciseList[]                     @relation("ExerciseListCreator")
  exerciseSessions                       ExerciseSession[]
  exerciseQuestionBookmarks              ExerciseQuestionBookmark[]
  studyTrackingSessions                  StudyTrackingSession[]
  studyActivityIntervals                 StudyActivityInterval[]
  studyGoals                             StudyGoal[]
  learningTasksCreated                   LearningTask[]                     @relation("LearningTaskCreator")
  learningTaskAssignments                LearningTaskRecipient[]
  learningTaskCompletions                LearningTaskCompletion[]
  studyCampaignsCreated                  StudyCampaign[]                    @relation("StudyCampaignCreator")
  badgeAwards                            BadgeAward[]
  badgeEvaluationState                   BadgeEvaluationState?
  studyGoalAchievements                  StudyGoalAchievement[]
  badgeDefinitionsCreated                BadgeDefinition[]                  @relation("BadgeDefinitionCreator")
  badgeDefinitionRevisionsCreated        BadgeDefinitionRevision[]          @relation("BadgeRevisionCreator")
  plannerPreferences                     PlannerPreferences?
  plannerCalendarFeed                    PlannerCalendarFeed?
  plannerColumns                         PlannerBoardColumn[]
  plannerTasks                           PlannerTask[]
  plannerEvents                          PlannerEvent[]
  plannerReminders                       PlannerReminder[]
  focusTimerSessions                     FocusTimerSession[]
  plannerNoteFolders                     PlannerNoteFolder[]
  plannerNotes                           PlannerNote[]
  plannerNoteTags                        PlannerNoteTag[]
  globalSearchHistory                    GlobalSearchHistory[]

  @@index([role])
  @@index([onboardingStatus], map: "Member_onboardingStatus_idx")
}

model Profile {
  id                     String   @id @default(cuid())
  clerkUserId            String   @unique
  username               String   @unique
  showInDirectory        Boolean  @default(true)
  showInCommunityAvatars Boolean  @default(true)
  displayName            String?
  avatarUrl              String?
  headline               String?
  bio                    String?  @db.Text
  occupation             String?
  institution            String?
  city                   String?
  state                  String?
  country                String?
  website                String?
  instagram              String?
  linkedin               String?
  interests              String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  member                 Member   @relation(fields: [clerkUserId], references: [id], onDelete: Cascade)

  @@index([displayName])
}

model LearningPath {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?       @db.Text
  coverUrl    String?
  status      ContentStatus @default(DRAFT)
  position    Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  courses     Course[]

  @@index([status, position])
}

model Course {
  id                   String                  @id @default(cuid())
  title                String
  subtitle             String?                 @db.Text
  slug                 String                  @unique
  description          String?                 @db.Text
  coverUrl             String?
  format               String?
  category             String?
  level                String?
  durationMinutes      Int?
  tags                 String[]                @default([])
  experience           CourseExperience        @default(ASYNC)
  teacherId            String?
  status               ContentStatus           @default(DRAFT)
  position             Int                     @default(0)
  publishedAt          DateTime?
  createdBy            String?
  updatedBy            String?
  learningPathId       String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  learningPath         LearningPath?           @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  modules              Module[]
  enrollments          Enrollment[]
  activities           Activity[]
  meetings             Meeting[]
  libraryBookmarks     LibraryBookmark[]
  collectionItems      ContentCollectionItem[]
  cohortCourseAccesses CohortCourseAccess[]

  @@unique([learningPathId, position])
  @@index([status, position])
  @@index([learningPathId, status, position])
}

model Module {
  id                      String                   @id @default(cuid())
  title                   String
  slug                    String
  description             String?                  @db.Text
  objectives              String[]                 @default([])
  position                Int                      @default(0)
  status                  ContentStatus            @default(DRAFT)
  courseId                String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  course                  Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons                 Lesson[]
  importedRecordingGroups ImportedRecordingGroup[]
  libraryBookmarks        LibraryBookmark[]

  @@unique([courseId, slug])
  @@unique([courseId, position])
  @@index([status, courseId, position])
}

model Lesson {
  id                   String                  @id @default(cuid())
  title                String
  slug                 String
  description          String?                 @db.Text
  objectives           String[]                @default([])
  content              Json
  kind                 LessonKind              @default(TEXT)
  status               ContentStatus           @default(DRAFT)
  position             Int                     @default(0)
  publishedAt          DateTime?
  createdBy            String?
  updatedBy            String?
  moduleId             String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  module               Module                  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources            LessonResource[]
  libraryItems         LibraryItem[]
  assets               LessonAsset[]
  assetUploads         LessonAssetUpload[]
  progress             LessonProgress[]
  activities           Activity[]
  importedRecordings   ImportedRecording[]
  collectionItems      ContentCollectionItem[]
  libraryBookmarks     LibraryBookmark[]
  cohortLessonReleases CohortLessonRelease[]

  @@unique([moduleId, slug])
  @@unique([moduleId, position])
  @@index([status, moduleId, position])
}

model LessonResource {
  id        String       @id @default(cuid())
  title     String
  kind      ResourceKind
  url       String       @db.Text
  position  Int          @default(0)
  lessonId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  lesson    Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
}

model LessonAsset {
  id                        String                   @id @default(cuid())
  title                     String
  kind                      LessonAssetKind
  scope                     LessonAssetScope         @default(GENERAL)
  mediaProvider             LessonAssetMediaProvider @default(STORAGE)
  mediaExternalId           String?                  @db.VarChar(64)
  youtubeSourceUrl          String?                  @db.Text
  youtubeVideoTitle         String?                  @db.Text
  youtubeThumbnailUrl       String?                  @db.Text
  youtubePrivacyStatus      String?                  @db.VarChar(16)
  youtubeEmbeddable         Boolean?
  youtubeCaptionsAvailable  Boolean?
  youtubeVerificationStatus String?                  @db.VarChar(32)
  youtubeCheckedAt          DateTime?
  youtubeStartAtSeconds     Int?
  youtubeEndAtSeconds       Int?
  storagePath               String?                  @db.Text
  externalUrl               String?                  @db.Text
  mimeType                  String?
  sizeBytes                 BigInt?
  durationSeconds           Int?
  checksum                  String?
  sourcePlatform            String?
  sourceId                  String?
  originalTitle             String?
  position                  Int                      @default(0)
  ownerMemberId             String?
  lessonId                  String
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  lesson                    Lesson                   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  ownerMember               Member?                  @relation("OwnedLessonAssets", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  importedRecording         ImportedRecording?
  playbackProgress          PlaybackProgress[]
  uploadVersions            LessonAssetUpload[]      @relation("LessonAssetUploadAsset")
  collectionItems           ContentCollectionItem[]
  libraryBookmarks          LibraryBookmark[]

  @@unique([lessonId, position])
  @@unique([sourcePlatform, sourceId])
  @@index([lessonId, kind, position])
  @@index([ownerMemberId, scope])
}

model LessonAssetUpload {
  id                     String                  @id @default(cuid())
  actorId                String                  @db.VarChar(128)
  idempotencyKey         String                  @db.Uuid
  lessonId               String
  expectedAssetId        String?
  expectedAssetUpdatedAt DateTime?
  assetId                String?
  storagePath            String                  @unique @db.Text
  originalFileName       String                  @db.VarChar(255)
  mimeType               String                  @db.VarChar(128)
  sizeBytes              BigInt
  status                 LessonAssetUploadStatus @default(PENDING)
  expiresAt              DateTime
  completedAt            DateTime?
  storageDeletedAt       DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  lesson                 Lesson                  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  asset                  LessonAsset?            @relation("LessonAssetUploadAsset", fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([actorId, idempotencyKey])
  @@index([lessonId, status, createdAt])
  @@index([actorId, status, createdAt])
  @@index([assetId])
  @@index([storageDeletedAt, status, expiresAt])
}

model Enrollment {
  id          String           @id @default(cuid())
  memberId    String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([memberId, courseId])
  @@index([courseId])
  @@index([memberId, status])
}

model AccessGrant {
  id             String             @id @default(cuid())
  memberId       String
  resourceType   AccessResourceType
  resourceId     String
  permission     AccessPermission   @default(VIEW)
  sourcePlatform String?
  sourceId       String?
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  member         Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, resourceType, resourceId])
  @@index([resourceType, resourceId])
  @@index([memberId, expiresAt])
}

model Cohort {
  id                  String                 @id @default(cuid())
  name                String
  normalizedName      String                 @unique
  slug                String                 @unique
  startsAt            DateTime
  endsAt              DateTime?
  lateJoinPolicy      CohortLateJoinPolicy   @default(ALL_ACTIVE)
  readAfterEndDays    Int                    @default(90)
  notifyOnNews        Boolean                @default(true)
  archivedAt          DateTime?
  version             Int                    @default(1)
  idempotencyKey      String?
  createdByMemberId   String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  createdBy           Member                 @relation("CohortCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  teachers            CohortTeacher[]
  memberships         CohortMembership[]
  invites             CohortInvite[]
  courseAccesses      CohortCourseAccess[]
  lessonReleases      CohortLessonRelease[]
  events              CohortEvent[]
  meetingTargets      MeetingCohortTarget[]
  calendarFeeds       CohortCalendarFeed[]
  accessGrantSources  AccessGrantSource[]
  activityTargets     ActivityCohortTarget[]
  announcementTargets AnnouncementCohort[]

  @@unique([createdByMemberId, idempotencyKey])
  @@index([archivedAt, startsAt, endsAt])
}

model CohortTeacher {
  cohortId           String
  memberId           String
  assignedByMemberId String
  assignedAt         DateTime @default(now())
  cohort             Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  member             Member   @relation("CohortTeacherMember", fields: [memberId], references: [id], onDelete: Cascade)
  assignedBy         Member   @relation("CohortTeacherAssigner", fields: [assignedByMemberId], references: [id], onDelete: Restrict)

  @@id([cohortId, memberId])
  @@index([memberId, cohortId])
}

model CohortMembership {
  id                  String             @id @default(cuid())
  activeKey           String?            @unique
  cohortId            String
  memberId            String
  status              CohortMemberStatus @default(ACTIVE)
  source              CohortMemberSource @default(MANUAL)
  joinedAt            DateTime           @default(now())
  leftAt              DateTime?
  movedFromCohortId   String?
  includePastReadOnly Boolean            @default(false)
  version             Int                @default(1)
  createdByMemberId   String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  cohort              Cohort             @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  member              Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy           Member?            @relation("CohortMembershipCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)

  @@index([cohortId, status, joinedAt])
  @@index([memberId, status, leftAt])
  @@index([movedFromCohortId])
}

model CohortInvite {
  id                String    @id @default(cuid())
  cohortId          String
  tokenHash         String    @unique
  email             String?
  expiresAt         DateTime
  maxUses           Int       @default(1)
  usedCount         Int       @default(0)
  revokedAt         DateTime?
  createdByMemberId String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  cohort            Cohort    @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  createdBy         Member    @relation("CohortInviteCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)

  @@index([cohortId, revokedAt, expiresAt])
}

model CohortCourseAccess {
  id                String            @id @default(cuid())
  activeKey         String?           @unique
  cohortId          String
  courseId          String
  releaseMode       CohortReleaseMode @default(ALL_AT_ONCE)
  startsAt          DateTime?
  revokedAt         DateTime?
  createdByMemberId String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  cohort            Cohort            @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy         Member            @relation("CohortCourseAccessCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)

  @@index([cohortId, revokedAt])
  @@index([courseId, revokedAt])
}

model CohortLessonRelease {
  id                String   @id @default(cuid())
  cohortId          String
  lessonId          String
  releaseAt         DateTime
  version           Int      @default(1)
  updatedByMemberId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  cohort            Cohort   @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  updatedBy         Member   @relation("CohortLessonReleaseUpdater", fields: [updatedByMemberId], references: [id], onDelete: Restrict)

  @@unique([cohortId, lessonId])
  @@index([cohortId, releaseAt])
  @@index([lessonId, releaseAt])
}

model CohortEvent {
  id                   String                           @id @default(cuid())
  idempotencyKey       String?
  cohortId             String
  title                String
  description          String?                          @db.Text
  startsAt             DateTime
  endsAt               DateTime?
  allDay               Boolean                          @default(false)
  color                String                           @default("#6B5B64")
  recurrence           PlannerRecurrence                @default(NONE)
  recurrenceUntil      DateTime?
  status               ContentStatus                    @default(DRAFT)
  version              Int                              @default(1)
  publishedAt          DateTime?
  createdByMemberId    String
  createdAt            DateTime                         @default(now())
